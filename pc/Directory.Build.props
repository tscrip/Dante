<Project>
  <!--
    Bluetooth LE (InTheHand.BluetoothLE) needs the WinRT-flavoured target on Windows; everywhere
    else plain net10.0 is used (BlueZ on Linux). Building on Windows, or publishing with -r win-*,
    picks the Windows target automatically, so `dotnet run` works unchanged on every OS.
  -->
  <PropertyGroup>
    <HankTfm Condition="'$(HankTfm)' == '' And ($([MSBuild]::IsOSPlatform('Windows')) Or $(RuntimeIdentifier.StartsWith('win')))">net10.0-windows10.0.19041.0</HankTfm>
    <HankTfm Condition="'$(HankTfm)' == ''">net10.0</HankTfm>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
