@page "/mood"
@inject ConfigStore Store
@inject BuddyEngine Engine

<PageTitle>Mood · DeskBuddy</PageTitle>

<h1>Mood &amp; personality</h1>
<p class="muted">The buddy's mood depends on how many things are waiting on you (from apps marked
    "affects mood") and how long the oldest one has waited. A rule fires when <em>either</em> limit is reached;
    the most severe firing rule wins. 0 disables a limit.</p>

@if (_saved) { <div class="notice">Saved.</div> }

<div class="panel">
    <h2>Thresholds</h2>
    <table>
        <thead><tr><th>Mood</th><th>When this many are waiting</th><th>...or the oldest has waited (minutes)</th><th></th></tr></thead>
        <tbody>
            <tr><td><strong>Happy</strong> <span class="muted">(^‿^)</span></td><td colspan="2" class="muted">Nothing waiting (or no rule fires)</td>
                <td><button class="btn sm" @onclick="() => Preview(Mood.Happy)">Preview</button></td></tr>
            @foreach (var rule in _cfg.Mood.Rules.OrderBy(r => r.Mood))
            {
                <tr>
                    <td><strong>@rule.Mood</strong></td>
                    <td><input type="number" min="0" @bind="rule.MinItems" style="max-width:8rem" /></td>
                    <td><input type="number" min="0" @bind="rule.MinOldestMinutes" style="max-width:8rem" /></td>
                    <td><button class="btn sm" @onclick="() => Preview(rule.Mood)">Preview</button></td>
                </tr>
            }
        </tbody>
    </table>
    <p class="muted small">"Preview" shows that mood on the buddy for 15 seconds.</p>
</div>

<div class="panel">
    <h2>Try it</h2>
    <div class="row">
        <label class="field"><span>Waiting items</span><input type="number" min="0" @bind="_whatIfCount" @bind:event="oninput" /></label>
        <label class="field"><span>Oldest waited (minutes)</span><input type="number" min="0" @bind="_whatIfMinutes" @bind:event="oninput" /></label>
        <div class="big">→ @WhatIf</div>
    </div>
</div>

<div class="panel">
    <h2>Personality</h2>
    <p class="muted small">How the buddy talks when it delivers new values.</p>
    <div class="row">
        @foreach (var p in Enum.GetValues<Personality>())
        {
            <label class="check"><input type="radio" name="personality" checked="@(_cfg.Personality == p)" @onchange="() => _cfg.Personality = p" /> @p</label>
        }
    </div>
    <p class="small"><em>@Sample</em></p>
</div>

<button class="btn primary" @onclick="Save">Save</button>

@code {
    private DeskBuddyConfig _cfg = new();
    private bool _saved;
    private int _whatIfCount = 2;
    private int _whatIfMinutes = 45;

    protected override void OnInitialized()
    {
        _cfg = Store.Snapshot();
        // Make sure every mood has a row to edit.
        foreach (var m in Enum.GetValues<Mood>().Where(m => m != Mood.Happy && _cfg.Mood.Rules.All(r => r.Mood != m)))
            _cfg.Mood.Rules.Add(new MoodRule { Mood = m });
    }

    private Mood WhatIf
    {
        get
        {
            var now = DateTimeOffset.UtcNow;
            var items = Enumerable.Range(0, Math.Max(0, _whatIfCount))
                .Select(i => new PendingItem(i.ToString(), "x", now.AddMinutes(i == 0 ? -_whatIfMinutes : 0)))
                .ToList();
            return MoodCalculator.Evaluate(_cfg.Mood, items, now).Mood;
        }
    }

    private string Sample =>
        QuipBank.Pick(_cfg.Personality,
            new QuipContext(new AppDefinition { Name = "PRs", QuipMinDelta = 1 }, 2, 4, 0, 0, null),
            new Random(42)) ?? "";

    private void Preview(Mood mood) => Engine.PreviewMood(mood, TimeSpan.FromSeconds(15));

    private void Save()
    {
        Store.Save(_cfg);
        _saved = true;
    }
}
