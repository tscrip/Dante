@page "/device"
@inherits LiveComponent
@inject ConfigStore Store

<PageTitle>Device · DeskBuddy</PageTitle>

<h1>Device</h1>

<div class="grid">
    <div class="panel">
        <h2>Connection</h2>
        <p>Status: <strong class="@(Link.Online ? "ok" : Link.Status == LinkStatus.Connected ? "warn" : "crit")">@(Link.Online ? "Online" : Link.Status.ToString())</strong>
            @if (Link.Firmware is not null) { <span class="muted small"> · firmware @Link.Firmware</span> }</p>
        @if (Link.LastError is not null) { <p class="crit small">@Link.LastError</p> }

        <label class="check"><input type="radio" name="conn" checked="@(_cfg.Device.Connection == ConnectionKind.Bluetooth)" @onchange="() => _cfg.Device.Connection = ConnectionKind.Bluetooth" />
            <span><strong>Bluetooth LE</strong> <span class="muted small">— wireless</span></span></label>
        <label class="check"><input type="radio" name="conn" checked="@(_cfg.Device.Connection == ConnectionKind.Usb)" @onchange="() => _cfg.Device.Connection = ConnectionKind.Usb" />
            <span><strong>USB cable</strong></span></label>

        @if (_cfg.Device.Connection == ConnectionKind.Bluetooth)
        {
            @if (!BleTransport.IsSupported)
            {
                <div class="notice error small">Bluetooth LE from the DeskBuddy app works on Windows and Linux. On this OS, use the USB cable.</div>
            }
            <label class="field"><span>Buddy's Bluetooth name</span>
                <div class="row" style="flex-wrap:nowrap">
                    <input type="text" @bind="_cfg.Device.BluetoothName" placeholder="DeskBuddy" />
                    <button class="btn sm" @onclick="Scan" disabled="@_scanning">@(_scanning ? "Scanning..." : "Scan")</button>
                </div>
                <span class="help">No pairing needed: the app finds the buddy by name and connects over Bluetooth LE.</span>
            </label>
            @if (_scanResult is not null)
            {
                <p class="small">
                    @if (_scanError is not null) { <span class="crit">@_scanError</span> }
                    else if (_scanResult.Count == 0) { <span class="muted">Nothing found. Is the buddy on, and not connected to another PC?</span> }
                    @foreach (var name in _scanResult) { <button class="btn sm" @onclick="() => _cfg.Device.BluetoothName = name" style="margin-right:.35rem">@name</button> }
                </p>
            }
        }
        else
        {
            <label class="field"><span>Port</span>
                <div class="row" style="flex-wrap:nowrap">
                    <select @bind="_cfg.Device.PortName">
                        <option value="">(choose)</option>
                        @foreach (var p in _ports) { <option value="@p">@p</option> }
                        @if (!string.IsNullOrEmpty(_cfg.Device.PortName) && !_ports.Contains(_cfg.Device.PortName))
                        { <option value="@_cfg.Device.PortName">@_cfg.Device.PortName</option> }
                    </select>
                    <button class="btn sm" @onclick="RefreshPorts" title="Rescan">⟳</button>
                </div>
                <span class="help">ESP32-S3: plug into the port marked <strong>USB</strong> (the "UART" port works too). Windows: COMx · Linux: /dev/ttyACM0 · macOS: /dev/cu.usbmodem…</span>
            </label>
            <label class="field"><span>Or type a port</span><input type="text" @bind="_cfg.Device.PortName" placeholder="COM5" /></label>
        }
        <label class="check"><input type="checkbox" @bind="_cfg.Device.AutoConnect" /> Connect (and keep reconnecting)</label>
        <label class="field"><span>Screen brightness: @_cfg.Device.Brightness</span>
            <input type="range" min="0" max="255" @bind="_cfg.Device.Brightness" @bind:event="oninput" /></label>
        <div class="row">
            <button class="btn primary" @onclick="Save">Save</button>
            <button class="btn" @onclick="Link.Reconnect">Reconnect</button>
        </div>
    </div>

    <div class="panel">
        <h2>Poke it</h2>
        <label class="field"><span>Say</span><input type="text" @bind="_say" maxlength="63" /></label>
        <div class="row">
            <button class="btn" @onclick="() => Engine.Say(_say)">Say it</button>
            <button class="btn" @onclick='() => Engine.TestAlert("Hey! Over here!", 1)'>Test nudge</button>
            <button class="btn" @onclick='() => Engine.TestAlert("Something is on fire!", 2)'>Test urgent</button>
        </div>
        <p class="muted small" style="margin-top:1rem">Buttons on the buddy: <strong>LEFT/RIGHT</strong> browse apps ·
            <strong>SELECT</strong> on the face plays a gag, on an app opens its link, long-press refreshes everything ·
            during a nudge SELECT = "I'm on it", LEFT/RIGHT = snooze.</p>
    </div>
</div>

<div class="panel">
    <h2>Screens</h2>
    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr))">
        <div>
            <label class="field"><span>Screen type</span>
                <select @bind="_cfg.Device.Display">
                    <option value="@DisplayType.Auto">Automatic: whatever the buddy finds</option>
                    <option value="@DisplayType.Oled128x32">OLED 0.91" 128×32 (SSD1306, I2C)</option>
                    <option value="@DisplayType.Lcd1602">LCD 1602 16×2 (PCF8574 I2C backpack)</option>
                    <option value="@DisplayType.Lcd2004">LCD 2004 20×4 (PCF8574 I2C backpack)</option>
                </select>
                @if (Link.Online && Link.OledDetected is not null)
                {
                    <span class="help">Buddy found at boot: OLED @(Link.OledDetected == true ? "✓" : "✗") ·
                        LCD @LcdFoundText · using: <strong>@(Link.DeviceLcd switch { LcdSize.Size20x4 => "LCD 2004", LcdSize.Size16x2 => "LCD 1602", _ => "OLED" })</strong></span>
                    @if (Link.OledDetected == false && Link.LcdDetectedAddress is not > 0)
                    {
                        <div class="notice error small">The buddy found no screen on its I2C bus. Check the wiring: SDA → GPIO 8, SCL → GPIO 9, plus power and GND.</div>
                    }
                    else if (_cfg.Device.Display == DisplayType.Oled128x32 && Link.OledDetected == false && Link.LcdDetectedAddress is > 0)
                    {
                        <div class="notice error small">OLED is selected but the buddy only found an LCD. Pick "LCD 1602" or "Automatic".</div>
                    }
                    else if (_cfg.Device.IsLcd && Link.LcdDetectedAddress is not > 0)
                    {
                        <div class="notice error small">An LCD is selected but the buddy didn't find an LCD backpack.</div>
                    }
                }
            </label>

            @if (_cfg.Device.Display == DisplayType.Auto)
            {
                <label class="field"><span>If the buddy finds an LCD, it's a</span>
                    <select @bind="_cfg.Device.LcdSize">
                        <option value="@LcdSize.Size16x2">1602 (16×2)</option>
                        <option value="@LcdSize.Size20x4">2004 (20×4)</option>
                    </select>
                    <span class="help">Both sizes look the same on the I2C bus, so the buddy can't tell them apart by itself.</span>
                </label>
            }
            @if (_cfg.Device.IsLcd)
            {
                <label class="field"><span>LCD I2C address</span>
                    <select value="@_cfg.Device.LcdAddress" @onchange="SetLcdAddress">
                        @foreach (var addr in LcdAddresses) { <option value="@addr">@AddressLabel(addr)</option> }
                    </select>
                    <span class="help">Same I2C pins as the OLED (SDA 8 / SCL 9). Use a level shifter: 5 V backpacks pull the bus to 5 V and the S3 is not 5 V tolerant. One character screen, so the face, apps and nudges are drawn as text plus custom characters.</span>
                </label>
                @if (Link.Online && Link.LcdDetectedAddress is > 0 and var found && found != _cfg.Device.LcdAddress)
                {
                    <div class="notice small">The buddy found an LCD at @Hex(found).
                        <button class="btn sm" @onclick="() => _cfg.Device.LcdAddress = found">Use it</button></div>
                }
                <label class="check"><input type="checkbox" checked="@(_cfg.Device.Brightness > 0)" @onchange="SetBacklight" /> Backlight on</label>
            }
            else
            {
                <label class="check"><input type="radio" name="screens" checked="@(_cfg.Device.ScreenCount != 2)" @onchange="() => _cfg.Device.ScreenCount = 1" />
                    <span><strong>1 screen</strong> <span class="muted small">— both eyes on one display</span></span></label>
                <label class="check"><input type="radio" name="screens" checked="@(_cfg.Device.ScreenCount == 2)" @onchange="() => _cfg.Device.ScreenCount = 2" />
                    <span><strong>2 screens</strong> <span class="muted small">— one big eye per display</span></span></label>

                @if (_cfg.Device.ScreenCount == 2)
                {
                    @if (Link.Online && Link.SecondScreenDetected == false)
                    {
                        <div class="notice error small">The buddy didn't find a second screen when it started. Check the wiring
                            (second screen on SDA 17 / SCL 18 by default) and restart it.</div>
                    }
                    <h3 class="small muted">On app screens</h3>
                    <label class="check"><input type="radio" name="layout" checked="@(_cfg.Device.DualLayout == DualLayout.Watch)" @onchange="() => _cfg.Device.DualLayout = DualLayout.Watch" />
                        <span>App on one screen, the other eye watches it</span></label>
                    <label class="check"><input type="radio" name="layout" checked="@(_cfg.Device.DualLayout == DualLayout.Mirror)" @onchange="() => _cfg.Device.DualLayout = DualLayout.Mirror" />
                        <span>App on both screens</span></label>
                    @if (_cfg.Device.DualLayout == DualLayout.Watch)
                    {
                        <label class="field"><span>App goes on the</span>
                            <select @bind="_cfg.Device.ContentScreen">
                                <option value="@ScreenSide.Right">right screen</option>
                                <option value="@ScreenSide.Left">left screen</option>
                            </select>
                            <span class="help">Speech bubbles and nudge messages appear there too.</span>
                        </label>
                    }
                    <h3 class="small muted">Mounting</h3>
                    <label class="check"><input type="checkbox" @bind="_cfg.Device.SwapScreens" /> Swap left and right screens</label>
                }
                <label class="check"><input type="checkbox" @bind="_cfg.Device.FlipScreen1" /> Upside down: @(_cfg.Device.ScreenCount == 2 ? "screen 1" : "screen")</label>
                @if (_cfg.Device.ScreenCount == 2)
                {
                    <label class="check"><input type="checkbox" @bind="_cfg.Device.FlipScreen2" /> Upside down: screen 2</label>
                }
            }
            <button class="btn primary" @onclick="Save" style="margin-top:.5rem">Save &amp; send to buddy</button>
            @if (_savedAt is { } at && DateTimeOffset.UtcNow - at < TimeSpan.FromSeconds(4))
            {
                <span class="ok small" style="margin-left:.5rem">Sent@(Link.Online ? "" : " (will apply when the buddy connects)")</span>
            }
        </div>
        <div>
            <ScreenLayoutPreview Settings="_cfg.Device" DetectedLcd="@Link.DeviceLcd" />
            <p class="muted small">The buddy remembers this, so it starts up in the right mode even before the PC connects.
                Before it has ever been configured it uses whichever screen it finds.</p>
        </div>
    </div>
</div>

<div class="panel">
    <h2>Traffic</h2>
    <div class="log">
        @foreach (var line in Link.RecentLog().Reverse())
        {
            <div class="@(line.Outgoing ? "out" : "")">@line.At.ToLocalTime().ToString("HH:mm:ss") @(line.Outgoing ? "→" : "←") @line.Text</div>
        }
    </div>
</div>

@code {
    private DeskBuddyConfig _cfg = new();
    private IReadOnlyList<string> _ports = [];
    private string _say = "Hello desk friend!";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _cfg = Store.Snapshot();
        RefreshPorts();
    }

    private void RefreshPorts() => _ports = SerialTransport.ListPorts();

    private bool _scanning;
    private IReadOnlyList<string>? _scanResult;

    private async Task Scan()
    {
        _scanning = true;
        _scanError = null;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            _scanResult = await BleTransport.ScanAsync(cts.Token);
        }
        catch (Exception ex)
        {
            _scanResult = [];
            _scanError = ex.Message;
        }
        finally { _scanning = false; }
    }

    private string? _scanError;

    private DateTimeOffset? _savedAt;

    // 0x20-0x27 = PCF8574, 0x38-0x3F = PCF8574A (set by the A0-A2 jumpers on the backpack).
    private static string Hex(int a) => $"0x{a:X2}";
    private static string AddressLabel(int a) => Hex(a) + (a == 0x27 ? " (PCF8574, most common)" : a == 0x3F ? " (PCF8574A)" : "");
    private string LcdFoundText => Link.LcdDetectedAddress is > 0 and var a ? $"✓ at {Hex(a)}" : "✗";
    private void SetLcdAddress(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var a)) _cfg.Device.LcdAddress = a; }
    private void SetBacklight(ChangeEventArgs e) => _cfg.Device.Brightness = e.Value is true ? 200 : 0;

    private IEnumerable<int> LcdAddresses =>
        new[] { 0x27, 0x3F }.Concat(Enumerable.Range(0x20, 8)).Concat(Enumerable.Range(0x38, 8))
            .Append(_cfg.Device.LcdAddress).Distinct();

    private void Save()
    {
        Store.Save(_cfg);
        _cfg = Store.Snapshot();
        _savedAt = DateTimeOffset.UtcNow;
    }
}
