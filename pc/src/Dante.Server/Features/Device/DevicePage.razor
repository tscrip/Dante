@page "/device"
@inherits LiveComponent
@inject ConfigStore Store

<PageTitle>Device · DANTE</PageTitle>

<h1>Device</h1>

<div class="grid">
    <div class="panel">
        <h2>Connection</h2>
        <p>Status: <strong class="@(Link.Online ? "ok" : Link.Status == LinkStatus.Connected ? "warn" : "crit")">@(Link.Online ? "Online" : Link.Status.ToString())</strong>
            @if (Link.Firmware is not null) { <span class="muted small"> · firmware @Link.Firmware</span> }</p>
        @if (Link.LastError is not null) { <p class="crit small">@Link.LastError</p> }

        <label class="check"><input type="radio" name="conn" checked="@(_cfg.Device.Connection == ConnectionKind.Bluetooth)" @onchange="() => _cfg.Device.Connection = ConnectionKind.Bluetooth" />
            <span><strong>Bluetooth LE</strong> <span class="muted small">— wireless</span></span></label>
        <label class="check"><input type="radio" name="conn" checked="@(_cfg.Device.Connection == ConnectionKind.Usb)" @onchange="() => _cfg.Device.Connection = ConnectionKind.Usb" />
            <span><strong>USB cable</strong></span></label>
        <label class="check"><input type="radio" name="conn" checked="@(_cfg.Device.Connection == ConnectionKind.Simulator)" @onchange="() => _cfg.Device.Connection = ConnectionKind.Simulator" />
            <span><strong>Simulator</strong> <span class="muted small">— no hardware: DANTE's firmware running on this PC</span></span></label>

        @if (_cfg.Device.Connection == ConnectionKind.Bluetooth)
        {
            @if (!BleTransport.IsSupported)
            {
                <div class="notice error small">Bluetooth LE from the DANTE app works on Windows and Linux. On this OS, use the USB cable.</div>
            }
            <label class="field"><span>DANTE's Bluetooth name</span>
                <div class="row" style="flex-wrap:nowrap">
                    <input type="text" @bind="_cfg.Device.BluetoothName" placeholder="DANTE" />
                    <button class="btn sm" @onclick="Scan" disabled="@_scanning">@(_scanning ? "Scanning..." : "Scan")</button>
                </div>
                <span class="help">No pairing needed: the app finds DANTE by name and connects over Bluetooth LE.</span>
            </label>
            @if (_scanResult is not null)
            {
                <p class="small">
                    @if (_scanError is not null) { <span class="crit">@_scanError</span> }
                    else if (_scanResult.Count == 0) { <span class="muted">Nothing found. Is DANTE on, and not connected to another PC?</span> }
                    @foreach (var name in _scanResult) { <button class="btn sm" @onclick="() => _cfg.Device.BluetoothName = name" style="margin-right:.35rem">@name</button> }
                </p>
            }
        }
        else if (_cfg.Device.Connection == ConnectionKind.Simulator)
        {
            <label class="field"><span>Pretend to have</span>
                <select value="@_cfg.Device.SimulatedHardware" @onchange="SetSimulatedHardware">
                    @foreach (var hw in Enum.GetValues<SimulatedHardware>()) { <option value="@hw">@hw.Describe()</option> }
                </select>
                <span class="help">See and press DANTE on the <a href="simulator">Simulator</a> page.</span>
            </label>
            <label class="field"><span>Simulator program</span>
                <input type="text" @bind="_cfg.Device.SimulatorPath" placeholder="automatic: firmware/.pio/build/simulator/program" />
                <span class="help">@SimulatorLocator.BuildHint</span>
            </label>
        }
        else
        {
            <label class="field"><span>Port</span>
                <div class="row" style="flex-wrap:nowrap">
                    <select @bind="_cfg.Device.PortName">
                        <option value="">(choose)</option>
                        @foreach (var p in _ports) { <option value="@p">@p</option> }
                        @if (!string.IsNullOrEmpty(_cfg.Device.PortName) && !_ports.Contains(_cfg.Device.PortName))
                        { <option value="@_cfg.Device.PortName">@_cfg.Device.PortName</option> }
                    </select>
                    <button class="btn sm" @onclick="RefreshPorts" title="Rescan">⟳</button>
                </div>
                <span class="help">ESP32-S3: plug into the port marked <strong>USB</strong> (the "UART" port works too). Windows: COMx · Linux: /dev/ttyACM0 · macOS: /dev/cu.usbmodem…
                    The yellow touch board shows up as Windows: COMx · Linux: /dev/ttyUSB0 · macOS: /dev/cu.usbserial…</span>
            </label>
            <label class="field"><span>Or type a port</span><input type="text" @bind="_cfg.Device.PortName" placeholder="COM5" /></label>
        }
        <label class="check"><input type="checkbox" @bind="_cfg.Device.AutoConnect" /> Connect (and keep reconnecting)</label>
        <label class="field"><span>Screen brightness: @_cfg.Device.Brightness</span>
            <input type="range" min="0" max="255" @bind="_cfg.Device.Brightness" @bind:event="oninput" /></label>
        <div class="row">
            <button class="btn primary" @onclick="Save">Save</button>
            <button class="btn" @onclick="Link.Reconnect">Reconnect</button>
        </div>
    </div>

    <div class="panel">
        <h2>Check wiring</h2>
        <p class="small muted">Asks DANTE which I2C devices answer on its bus (SDA 8 / SCL 9) right now. No restart
            needed, so you can rewire and check again. The 3.5" TFT is on SPI and can't be detected.</p>
        <button class="btn" @onclick="CheckWiring" disabled="@(!Link.Online)">Check wiring</button>
        @if (!Link.Online) { <span class="muted small"> (DANTE needs to be connected)</span> }
        @if (Link.LastDiag is { } diag && _diagAsked is { } asked && diag.At >= asked)
        {
            <ul class="small" style="margin:.75rem 0 .25rem 1.1rem;padding:0">
                @foreach (var hint in diag.Explain(_cfg.Device)) { <li>@hint</li> }
            </ul>
            <pre class="small" style="white-space:pre-wrap">@(diag.Scan.Replace(" | ", "\n"))</pre>
        }
        else if (_diagAsked is not null)
        {
            <p class="muted small">Asking...</p>
        }
    </div>

    <div class="panel">
        <h2>Poke it</h2>
        <label class="field"><span>Say</span><input type="text" @bind="_say" maxlength="63" /></label>
        <div class="row">
            <button class="btn" @onclick="() => Engine.Say(_say)">Say it</button>
            <button class="btn" @onclick='() => Engine.TestAlert("Hey! Over here!", 1)'>Test nudge</button>
            <button class="btn" @onclick='() => Engine.TestAlert("Something is on fire!", 2)'>Test urgent</button>
        </div>
        @if (Link.TouchScreen)
        {
            <p class="muted small" style="margin-top:1rem">This DANTE has a touch screen instead of buttons.
                <strong>Swipe left or right</strong> to browse widgets, <strong>swipe down</strong> to go back to the face ·
                <strong>tap anywhere</strong> for SELECT: a gag on the face, a widget's link, hold to refresh everything ·
                tap with <strong>two fingers</strong> for MAGIC, which does what you set on the <a href="magic">Magic button</a> page ·
                during a nudge, tap = "I'm on it", swipe = snooze.</p>
        }
        else
        {
            <p class="muted small" style="margin-top:1rem">Buttons on DANTE: <strong>LEFT/RIGHT</strong> browse widgets ·
                <strong>SELECT</strong> on the face plays a gag, on a widget opens its link, long-press refreshes everything ·
                <strong>MAGIC</strong> does what you set on the <a href="magic">Magic button</a> page ·
                during a nudge SELECT = "I'm on it", LEFT/RIGHT = snooze.</p>
        }
    </div>
</div>

<div class="panel">
    <h2>Screens</h2>
    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr))">
        <div>
            <label class="field"><span>Screen type</span>
                <select @bind="_cfg.Device.Display">
                    <option value="@DisplayType.Auto">Automatic: the OLED if it answers, otherwise the TFT</option>
                    <option value="@DisplayType.Oled128x32">OLED 0.91" 128×32 (SSD1306, I2C)</option>
                    <option value="@DisplayType.Tft35">TFT 3.5" 480×320 colour (ST7796, SPI)</option>
                </select>
                <span class="help">DANTE drives one screen.</span>
                @if (Link.Online && Link.OledDetected is not null)
                {
                    <span class="help">DANTE found at boot: OLED @(Link.OledDetected == true ? "✓" : "✗") · using: <strong>@UsingText</strong></span>
                    @if (_cfg.Device.Display == DisplayType.Oled128x32 && Link.OledDetected == false)
                    {
                        <div class="notice error small">DANTE didn't find the OLED on its I2C bus. Check the wiring: SDA → GPIO 8, SCL → GPIO 9, plus power and GND.</div>
                    }
                    else if (_cfg.Device.Display == DisplayType.Auto && Link.DeviceTft && !Link.TouchScreen)
                    {
                        <div class="notice small">No OLED answered, so DANTE assumes the 3.5" TFT (it can't detect an SPI screen).
                            If you have one, pick it above so DANTE doesn't have to guess.</div>
                    }
                }
            </label>

            <label class="check"><input type="checkbox" @bind="_cfg.Device.Flip" /> Screen is mounted upside down</label>
            @if (_cfg.Device.Display is DisplayType.Tft35 or DisplayType.Auto)
            {
                <label class="field" style="margin-top:.5rem"><span>Accent colour <span class="muted small">(3.5" TFT)</span></span>
                    <div class="row" style="gap:.4rem">
                        @foreach (var (name, hex) in AccentPresets)
                        {
                            <button type="button" class="swatch @(SameColor(hex) ? "on" : "")" title="@name" style="background:@hex"
                                    @onclick="() => _cfg.Device.AccentColor = hex"></button>
                        }
                        <input type="color" value="@(_cfg.Device.AccentColor.ToLowerInvariant())" title="Any colour"
                               @onchange="e => _cfg.Device.AccentColor = e.Value?.ToString() ?? DeviceSettings.DefaultAccent" />
                    </div>
                    <span class="help">The DANTE title, the happy eyes, the current page dot and highlights. Mood colours (antsy yellow, grumpy orange, ...) stay as they are.</span>
                </label>
                <div class="accent-preview">
                    <span style="color:@_cfg.Device.AccentColor">DANTE</span>
                    <span class="muted small" style="color:@_cfg.Device.AccentColor">happy</span>
                    <i style="background:@_cfg.Device.AccentColor"></i><i style="background:@_cfg.Device.AccentColor"></i>
                </div>
            }
            <button class="btn primary" @onclick="Save" style="margin-top:.5rem">Save &amp; send to DANTE</button>
            @if (_savedAt is { } at && DateTimeOffset.UtcNow - at < TimeSpan.FromSeconds(4))
            {
                <span class="ok small" style="margin-left:.5rem">Sent@(Link.Online ? "" : " (will apply when DANTE connects)")</span>
            }
        </div>
        <div>
            <h3 class="small muted">Wiring</h3>
            @if (Link.TouchScreen)
            {
                <p class="small">Nothing to wire: this DANTE is a yellow ESP32-3248S035C board, with the 3.5" screen and its touch
                    panel built in. It always uses that screen, whatever the screen type above says.</p>
            }
            else
            {
                <table class="small">
                    <tbody>
                        @foreach (var (screenPin, gpio) in WiringFor(_cfg.Device.Display))
                        {
                            <tr><td>@screenPin</td><td>→ @gpio</td></tr>
                        }
                    </tbody>
                </table>
            }
            <p class="muted small">DANTE remembers the screen type, so it starts up in the right mode even before the PC connects.
                Before it has ever been configured it uses the OLED if it answers, and the TFT otherwise.</p>
        </div>
    </div>
</div>

@if (Link.HasLight || Link.HasExtraButton)
{
    <div class="panel">
        <h2>Notification light &amp; MAGIC button</h2>
        <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr))">
            <div>
                @if (Link.HasLight)
                {
                    <div class="fields">
                        <span class="small"><strong>Light</strong></span>
                        <label class="check"><input type="radio" name="light" checked="@(_cfg.Device.Light == NotificationLight.Waiting)" @onchange="() => _cfg.Device.Light = NotificationLight.Waiting" />
                            <span>Whenever something is waiting <span class="muted small">— a short blink every 2 s; blinking during a nudge, fast when urgent</span></span></label>
                        <label class="check"><input type="radio" name="light" checked="@(_cfg.Device.Light == NotificationLight.Nudges)" @onchange="() => _cfg.Device.Light = NotificationLight.Nudges" />
                            <span>Only during nudges <span class="muted small">— blinking, fast when urgent</span></span></label>
                        <label class="check"><input type="radio" name="light" checked="@(_cfg.Device.Light == NotificationLight.Off)" @onchange="() => _cfg.Device.Light = NotificationLight.Off" />
                            <span>Off</span></label>
                    </div>
                }
                @if (Link.HasExtraButton)
                {
                    <label class="check" style="margin-top:.75rem"><input type="checkbox" @bind="_cfg.Device.ExtraMagicButton" />
                        <span>A MAGIC button is wired to IO35 <span class="muted small">— it does what you set on the <a href="magic">Magic button</a> page.
                            Only tick this once the button and its resistor are in: without the resistor, IO35 picks up noise and DANTE would see presses that never happened.</span></span></label>
                }
                <button class="btn primary" @onclick="Save" style="margin-top:.75rem">Save &amp; send to DANTE</button>
            </div>
            <div>
                <h3 class="small muted">Wiring (connector P3 on the yellow board)</h3>
                <table class="small">
                    <tbody>
                        <tr><td>Light</td><td>IO22 → 330 Ω resistor → LED (long leg) · LED (short leg) → GND. A lit button (e.g. 12 V): its + to IO22 and − to GND, no resistor (it has one built in; dimmer at 3.3 V)</td></tr>
                        <tr><td>MAGIC button</td><td>IO35 → button (NO and C) → GND, plus a 10 kΩ resistor from IO35 to the 3.3V pin of connector CN1</td></tr>
                        <tr><td>IO21</td><td>leave it free: the touch screen uses it</td></tr>
                    </tbody>
                </table>
                <p class="muted small">CN1 (GND, IO22, IO21, 3.3V) carries the same IO22 as P3, so the light can go on either. A brighter light or
                    an LED strip needs a transistor in between: a pin can only power a single small LED.</p>
            </div>
        </div>
    </div>
}

<div class="panel">
    <h2>Traffic</h2>
    <div class="log">
        @foreach (var line in Link.RecentLog().Reverse())
        {
            <div class="@(line.Outgoing ? "out" : "")">@line.At.ToLocalTime().ToString("HH:mm:ss") @(line.Outgoing ? "→" : "←") @line.Text</div>
        }
    </div>
</div>

@code {
    private DanteConfig _cfg = new();
    private IReadOnlyList<string> _ports = [];
    private string _say = "Hello desk friend!";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _cfg = Store.Snapshot();
        RefreshPorts();
    }

    private void RefreshPorts() => _ports = SerialTransport.ListPorts();

    private bool _scanning;
    private IReadOnlyList<string>? _scanResult;

    private async Task Scan()
    {
        _scanning = true;
        _scanError = null;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            _scanResult = await BleTransport.ScanAsync(cts.Token);
        }
        catch (Exception ex)
        {
            _scanResult = [];
            _scanError = ex.Message;
        }
        finally { _scanning = false; }
    }

    private string? _scanError;

    private DateTimeOffset? _savedAt;

    private void SetSimulatedHardware(ChangeEventArgs e)
    {
        if (Enum.TryParse<SimulatedHardware>(e.Value?.ToString(), out var hw)) hw.ApplyTo(_cfg.Device);
    }

    private DateTimeOffset? _diagAsked;

    private void CheckWiring()
    {
        _diagAsked = DateTimeOffset.UtcNow.AddSeconds(-1);
        Link.Send(DeviceProtocol.Diag());
    }

    private string UsingText => Link.DeviceDisplay == "tft" ? "TFT 3.5\"" : "OLED";

    /// <summary>Screen pin → ESP32-S3 GPIO, matching firmware/src/config.h.</summary>
    private static IEnumerable<(string ScreenPin, string Gpio)> WiringFor(DisplayType display) => display switch
    {
        DisplayType.Tft35 =>
        [
            ("VCC", "3V3"), ("GND", "GND"), ("SCL (SPI clock)", "GPIO 12"), ("SDA (SPI data)", "GPIO 11"),
            ("RST", "GPIO 14"), ("DC", "GPIO 13"), ("CS", "GPIO 10"), ("BL", "GPIO 21"), ("SDO", "not connected"),
        ],
        DisplayType.Oled128x32 => [("VCC", "3V3"), ("GND", "GND"), ("SDA", "GPIO 8"), ("SCL", "GPIO 9")],
        _ =>
        [
            ("OLED SDA · SCL", "GPIO 8 · 9"),
            ("TFT SCL · SDA · CS · DC · RST · BL", "GPIO 12 · 11 · 10 · 13 · 14 · 21"),
        ],
    };
    private static readonly (string Name, string Hex)[] AccentPresets =
    [
        ("Teal (default)", "#5EEAD4"), ("Sky", "#7DD3FC"), ("Violet", "#A78BFA"), ("Pink", "#F472B6"),
        ("Lime", "#A3E635"), ("Amber", "#FBBF24"), ("Copper", "#B87333"), ("White", "#E2E8F0"),
    ];

    private bool SameColor(string hex) => DeviceSettings.ParseColor(hex) == DeviceSettings.ParseColor(_cfg.Device.AccentColor);

    private void Save()
    {
        Store.Save(_cfg);
        _cfg = Store.Snapshot();
        _savedAt = DateTimeOffset.UtcNow;
    }
}
