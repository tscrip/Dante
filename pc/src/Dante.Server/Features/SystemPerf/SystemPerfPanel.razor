@* Live numbers on the plugin page, so you can see what DANTE will get. *@
@using System.Globalization
@implements IDisposable
@inject ISystemStats Stats

<div class="panel">
    <h2>Right now on this PC <span class="muted small">(@Stats.Platform)</span></h2>
    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
    else
    {
        <div class="row" style="gap:2rem">
            <div><div class="muted small">CPU</div><div class="big">@(_cpu is { } c ? $"{c:0}%" : "…")</div></div>
            <div><div class="muted small">Memory</div><div class="big">@(_memory is { } m ? $"{m.Percent:0}%" : "…")</div>
                @if (_memory is { } mem) { <div class="muted small">@Gb(mem.Used) of @Gb(mem.Total) GB in use</div> }</div>
        </div>
        <p class="muted small">Add a <strong>CPU &amp; memory</strong> widget below to put this on DANTE. "Check every" sets how
            often it samples (every 2 seconds by default).</p>
    }
</div>

@code {
    private Timer? _timer;
    private CpuTimes? _last;
    private double? _cpu;
    private MemoryUse? _memory;
    private string? _error;

    protected override void OnInitialized()
    {
        _last = Stats.ReadCpu();
        _memory = Stats.ReadMemory();
        if (_last is null || _memory is null) _error = $"DANTE can't read the CPU or memory use on {Stats.Platform}.";
        else _timer = new Timer(_ => InvokeAsync(Sample), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(2));
    }

    private void Sample()
    {
        var now = Stats.ReadCpu();
        if (now is { } n && _last is { } l) _cpu = SystemPerfSource.Percent(l, n);
        _last = now;
        _memory = Stats.ReadMemory();
        StateHasChanged();
    }

    private static string Gb(ulong bytes) => (bytes / 1073741824.0).ToString("0.0", CultureInfo.InvariantCulture);

    public void Dispose() => _timer?.Dispose();
}
