@* A small drawing of DANTE wearing a look, in the same 128x32 coordinates the firmware uses. *@
<svg class="look-preview" viewBox="0 0 128 32" role="img" aria-label="@Look.Title()">
    <rect width="128" height="32" fill="#000" />
    @if (Look == Look.Nerd)
    {
        <rect x="31" y="2.5" width="28" height="27" rx="7" fill="none" stroke="var(--dante-accent, #5EEAD4)" stroke-width="1.4" />
        <rect x="69" y="2.5" width="28" height="27" rx="7" fill="none" stroke="var(--dante-accent, #5EEAD4)" stroke-width="1.4" />
        <rect x="59" y="11.4" width="10" height="1.3" fill="var(--dante-accent, #5EEAD4)" />
        <rect x="25" y="8.4" width="6" height="1.2" fill="var(--dante-accent, #5EEAD4)" />
        <rect x="97" y="8.4" width="6" height="1.2" fill="var(--dante-accent, #5EEAD4)" />
    }
    <rect x="@(64 - Gap / 2 - EyeW)" y="@(16 - EyeH / 2)" width="@EyeW" height="@EyeH" rx="4" fill="var(--dante-accent, #5EEAD4)" />
    <rect x="@(64 + Gap / 2)" y="@(16 - EyeH / 2)" width="@EyeW" height="@EyeH" rx="4" fill="var(--dante-accent, #5EEAD4)" />
    @if (Look == Look.Gentleman)
    {
        <rect x="@(64 - Gap / 2 - EyeW)" y="@(16 - EyeH / 2)" width="@EyeW" height="3" fill="#000" />
        <rect x="@(64 + Gap / 2)" y="@(16 - EyeH / 2)" width="@EyeW" height="3" fill="#000" />
        <ellipse cx="57.5" cy="29" rx="7" ry="2.3" fill="var(--dante-accent, #5EEAD4)" />
        <ellipse cx="70.5" cy="29" rx="7" ry="2.3" fill="var(--dante-accent, #5EEAD4)" />
        <ellipse cx="50.2" cy="27.4" rx="1.9" ry="1.5" fill="var(--dante-accent, #5EEAD4)" />
        <ellipse cx="77.8" cy="27.4" rx="1.9" ry="1.5" fill="var(--dante-accent, #5EEAD4)" />
        <polygon points="62.6,26.4 65.4,26.4 64,29.4" fill="#000" />
    }
    else if (Look == Look.GrumpyUncle)
    {
        <polygon points="@Brow(true)" fill="var(--dante-accent, #5EEAD4)" />
        <polygon points="@Brow(false)" fill="var(--dante-accent, #5EEAD4)" />
        <rect x="53" y="27.4" width="22" height="3.4" rx="1.6" fill="var(--dante-accent, #5EEAD4)" />
    }
    else if (Look == Look.Party)
    {
        <polygon points="91,14 103,14 99,4" fill="var(--dante-accent, #5EEAD4)" />
        <circle cx="99" cy="3.5" r="1.8" fill="var(--dante-accent, #5EEAD4)" />
        <circle cx="20" cy="8" r="0.9" fill="var(--dante-accent, #5EEAD4)" />
        <circle cx="110" cy="22" r="0.9" fill="var(--dante-accent, #5EEAD4)" />
    }
</svg>

@code {
    [Parameter, EditorRequired] public Look Look { get; set; }

    private const float Gap = 16;
    private float EyeW => Look switch { Look.Party => 24, Look.Nerd => 18, Look.Gentleman => 20, _ => 22 };
    private float EyeH => Look switch { Look.Party => 24, Look.Nerd => 18, Look.Gentleman => 17, Look.GrumpyUncle => 18, _ => 22 };

    // A thick brow: high at the outer end, low by the nose.
    private string Brow(bool left)
    {
        float top = 16 - EyeH / 2 - 1.5f;
        float outer = left ? 64 - Gap / 2 - EyeW - 1.5f : 64 + Gap / 2 + EyeW + 1.5f;
        float inner = left ? 64 - Gap / 2 + 1.5f : 64 + Gap / 2 - 1.5f;
        return FormattableString.Invariant($"{outer},{top - 4} {inner},{top - 1} {inner},{top + 1.6} {outer},{top - 1.4}");
    }
}
