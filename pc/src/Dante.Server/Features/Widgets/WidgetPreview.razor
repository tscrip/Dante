@* Shows a widget the way DANTE draws it (the 128x32 layout; the 3.5" TFT shows the same, scaled up in colour). *@

<OledPreview Visual="Visual" Name="@Name" Value="Value" Value2="Value2" Label1="@Label1" Label2="@Label2" Min="Min" Max="Max" Unit="@Unit" Text="@Text" Level="Level" Scale="Scale" Sample="Sample" />

@code {
    [Parameter] public VisualKind Visual { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public double? Value { get; set; }
    [Parameter] public double? Value2 { get; set; }
    [Parameter] public string Label1 { get; set; } = "";
    [Parameter] public string Label2 { get; set; } = "";
    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public string? Text { get; set; }
    [Parameter] public int Level { get; set; }
    [Parameter] public int Scale { get; set; } = 3;
    [Parameter] public bool Sample { get; set; } = true;
    // Kept for callers that pass the carousel position; the 128x32 preview doesn't draw page dots.
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int Pages { get; set; } = 1;
}
