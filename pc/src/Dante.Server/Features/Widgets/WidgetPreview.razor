@* Shows a widget the way the configured screen type will show it. *@
@inject ConfigStore Store
@inject DeviceLink Link

@if (ShowsLcd)
{
    <LcdPreview Size="LcdSizeShown" Page="Page" Pages="Pages" Visual="Visual" Name="@Name" Value="Value" Min="Min" Max="Max" Unit="@Unit" Text="@Text" Level="Level" Sample="Sample" />
}
else
{
    <OledPreview Visual="Visual" Name="@Name" Value="Value" Min="Min" Max="Max" Unit="@Unit" Text="@Text" Level="Level" Scale="Scale" Sample="Sample" />
}

@code {
    [Parameter] public VisualKind Visual { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public double? Value { get; set; }
    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public string? Text { get; set; }
    [Parameter] public int Level { get; set; }
    [Parameter] public int Scale { get; set; } = 3;
    [Parameter] public bool Sample { get; set; } = true;
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int Pages { get; set; } = 1;

    // Automatic: preview whatever DANTE says it's using.
    private bool ShowsLcd => Store.Snapshot().Device is var d && (d.IsLcd || (d.Display == DisplayType.Auto && Link.DeviceLcd is not null));
    private LcdSize LcdSizeShown => Store.Snapshot().Device is var d && d.IsLcd ? d.EffectiveLcdSize : Link.DeviceLcd ?? d.LcdSize;
}
