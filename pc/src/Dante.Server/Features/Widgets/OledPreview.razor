@* A rough 128x32 rendering of a widget visual so you can see what you're picking.
   Built as a string because Razor reserves the SVG <text> element name. *@
@using System.Globalization
@using System.Net

<div class="oled" title="Preview of the 128x32 OLED">@((MarkupString)Svg())</div>

@code {
    [Parameter] public VisualKind Visual { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public double? Value { get; set; }
    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public string? Text { get; set; }
    [Parameter] public int Level { get; set; }
    [Parameter] public int Scale { get; set; } = 3;
    /// <summary>Show a made-up sample value when there's no data (editor) rather than "-" (dashboard).</summary>
    [Parameter] public bool Sample { get; set; } = true;

    private const string Px = "var(--oled-px)";
    private const string Bg = "var(--oled-bg)";

    private double Fraction => Value is { } v && Max > Min ? Math.Clamp((v - Min) / (Max - Min), 0, 1) : Sample ? 0.6 : 0;
    private string ValueText => Value is null && !Sample ? "-" : Format.Number(Value ?? Min + (Max - Min) * 0.6);
    // Timer: the value is the seconds left; the bar fills up as time passes.
    private string Clock => Value is { } s ? $"{(int)(s / 60)}:{(int)(s % 60):00}" : Sample ? "18:42" : "--:--";
    private double TimerFraction => Value is { } s && Max > 0 ? Math.Clamp(1 - s / Max, 0, 1) : Sample ? 0.25 : 0;

    private string Svg()
    {
        var body = Visual switch
        {
            VisualKind.Gauge =>
                $"""<path d="{Arc(1)}" fill="none" stroke-width="1"/><path d="{Arc(Fraction)}" fill="none" stroke-width="5"/>""" +
                $"""<line x1="20" y1="30" x2="{N(20 + 14 * Math.Cos(Math.PI * (1 - Fraction)))}" y2="{N(30 - 14 * Math.Sin(Math.PI * (1 - Fraction)))}" stroke-width="1.5"/>""" +
                T(46, 7, 7, Name) +
                $"""<text x="46" y="27" font-size="17" font-weight="700" stroke="none">{E(ValueText)}<tspan font-size="8">{E(Unit)}</tspan></text>""",
            VisualKind.Bar =>
                T(1, 7, 7, Name) +
                """<rect x="1" y="14" width="96" height="12" fill="none" rx="2"/>""" +
                $"""<rect x="3" y="16" width="{N(92 * Fraction)}" height="8" stroke="none" rx="1"/>""" +
                T(101, 24, 9, ValueText, "font-weight=\"700\""),
            VisualKind.Counter =>
                T(1, 9, 8, Name) + T(1, 27, 7, Text ?? "", "opacity=\".8\"") +
                T(126, 29, 26, ValueText, "font-weight=\"700\" text-anchor=\"end\""),
            VisualKind.Text =>
                T(1, 7, 7, Name) + T(1, 24, 11, Text ?? "Hello from the PC!"),
            VisualKind.Sparkline =>
                T(1, 7, 7, Name) +
                $"""<polyline points="{Spark()}" fill="none" stroke-width="1"/>""" +
                T(126, 7, 7, ValueText + Unit, "text-anchor=\"end\""),
            VisualKind.Status =>
                $"""<circle cx="14" cy="16" r="11" fill="{(Level == 0 ? "none" : Px)}"/>""" +
                T(14, 21, 14, Level switch { 0 => "✓", 1 => "!", _ => "×" },
                    $"font-weight=\"700\" text-anchor=\"middle\" fill=\"{(Level == 0 ? Px : Bg)}\"") +
                T(30, 11, 8, Name) + T(30, 25, 8, Text ?? "all quiet", "opacity=\".85\""),
            VisualKind.Timer =>
                T(1, 7, 7, Name) + T(126, 7, 7, Text ?? "Focus 1/4", "text-anchor=\"end\" opacity=\".85\"") +
                T(64, 24, 17, Clock, "font-weight=\"700\" text-anchor=\"middle\"") +
                """<rect x="1" y="28" width="126" height="3" fill="none" stroke-width=".6"/>""" +
                $"""<rect x="1" y="28" width="{N(126 * TimerFraction)}" height="3" stroke="none"/>""",
            _ => "",
        };
        return $"""<svg viewBox="0 0 128 32" width="{128 * Scale}" height="{32 * Scale}" font-family="monospace" fill="{Px}" stroke="{Px}">{body}</svg>""";
    }

    private static string T(double x, double y, double size, string content, string extra = "") =>
        $"""<text x="{N(x)}" y="{N(y)}" font-size="{N(size)}" stroke="none" {extra}>{E(content)}</text>""";

    private static string E(string s) => WebUtility.HtmlEncode(s);
    private static string N(double d) => d.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Arc(double f)
    {
        const double cx = 20, cy = 30, r = 17;
        var a = Math.PI * (1 - Math.Max(f, 0.001));
        return $"M {N(cx - r)} {N(cy)} A {N(r)} {N(r)} 0 0 1 {N(cx + r * Math.Cos(a))} {N(cy - r * Math.Sin(a))}";
    }

    private string Spark() => string.Join(' ', Enumerable.Range(0, 32).Select(i =>
        $"{N(2 + i * 4)},{N(30 - 18 * (0.5 + 0.35 * Math.Sin(i / 3.0) + 0.15 * Math.Sin(i * 1.7)) * (0.4 + 0.6 * Fraction))}"));
}
