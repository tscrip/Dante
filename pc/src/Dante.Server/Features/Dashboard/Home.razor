@page "/"
@inherits LiveComponent

<PageTitle>DANTE</PageTitle>

<h1>Dashboard</h1>

<div class="grid">
    <div class="panel">
        <h2>DANTE</h2>
        @if (Link.Online)
        {
            <p><span class="ok"><span class="dot"></span>Online</span> on <code>@Link.PortName</code></p>
            <p class="muted small">Firmware @(Link.Firmware ?? "?")</p>
        }
        else if (Link.Status == LinkStatus.Connected)
        {
            <p><span class="warn"><span class="dot"></span>Connected, DANTE is silent</span> <code>@Link.PortName</code></p>
            <p class="muted small">Is it powered on and in range?</p>
        }
        else
        {
            <p><span class="crit"><span class="dot"></span>@Link.Status</span></p>
            <p class="muted small">@(Link.LastError ?? "Set up the connection on the Device page.")</p>
        }
        <a class="btn sm" href="device">Device settings</a>
    </div>

    <div class="panel">
        <h2>Mood</h2>
        <div class="mood-face">@MoodFace(Mood.Mood)</div>
        <p><strong>@Mood.Mood</strong>
            <span class="muted"> · @Mood.PendingCount waiting@(Mood.PendingCount > 0 ? $", oldest {Format.Age(Mood.OldestWait)}" : "")</span>
        </p>
        <a class="btn sm" href="mood">Tune thresholds</a>
    </div>

    <div class="panel">
        <h2>Say something</h2>
        <div class="row">
            <input type="text" @bind="_say" @bind:event="oninput" maxlength="63" placeholder="Hello desk friend!" />
            <button class="btn" @onclick="SayIt" disabled="@string.IsNullOrWhiteSpace(_say)">Send</button>
        </div>
        <div class="row" style="margin-top:.75rem">
            <button class="btn sm" @onclick="Engine.PollAll">Refresh all widgets</button>
            <button class="btn sm" @onclick='() => Engine.TestAlert("Hey! Over here!", 1)'>Test nudge</button>
        </div>
    </div>
</div>

<div class="panel">
    <div class="row spread"><h2>Active widgets</h2><a class="btn sm primary" href="widgets/new">+ Add widget</a></div>
    @if (Widgets.Count == 0)
    {
        <p class="muted">No active widgets. <a href="widgets">Switch some on</a> or <a href="plugins">browse the plugins</a>.</p>
    }
    <div class="grid">
        @foreach (var a in Widgets)
        {
            <div class="panel" style="margin:0">
                <div class="row spread">
                    <strong>@a.Definition.Name</strong>
                    @if (a.AlertRaised) { <span class="pill crit">nudging</span> }
                    else { <span class="pill @LevelClass(a.Level)">@(a.Level switch { 0 => "ok", 1 => "warn", _ => "crit" })</span> }
                </div>
                <div style="margin:.5rem 0">
                    <AppPreview Page="@(Carousel.IndexOf(a.Definition.Id) + 1)" Pages="Carousel.Count" Visual="a.Definition.Visual" Name="@a.Definition.Name" Value="a.Reading?.Value" Min="a.Definition.Min" Max="a.Definition.Max"
                                 Unit="@a.Definition.Unit" Text="@a.Reading?.Text" Level="a.Level" Scale="2" Sample="false" />
                </div>
                @if (a.Error is not null) { <p class="crit small">@a.Error</p> }
                <p class="muted small">
                    @(a.UpdatedAt is { } u ? $"updated {Format.Age(DateTimeOffset.UtcNow - u)} ago" : "no data yet")
                    · <a href="widgets/@a.Definition.Id">edit</a>
                    · <a href="" @onclick="() => Engine.PollNow(a.Definition.Id)" @onclick:preventDefault>refresh</a>
                </p>
            </div>
        }
    </div>
</div>

@code {
    private string _say = "";
    private IReadOnlyList<WidgetStatus> Widgets => Engine.Snapshot();
    // Widgets that are screens on DANTE, in carousel order.
    private List<string> Carousel => [.. Widgets.Where(a => a.Definition.ShowInCarousel).Select(a => a.Definition.Id)];
    private MoodResult Mood => Engine.CurrentMood;

    private void SayIt()
    {
        Engine.Say(_say);
        _say = "";
    }
}
