@* Sketch of what each physical screen shows for the face and for an app screen. *@
@using System.Globalization

@if (Settings.IsLcd || (Settings.Display == DisplayType.Auto && DetectedLcd is not null))
{
    var size = Settings.IsLcd ? Settings.EffectiveLcdSize : DetectedLcd!.Value;
    var twoLcds = Settings.ScreenCount == 2 || (Settings.ScreenCount == 0 && DetectedScreens == 2);
    var appOnLeft = Settings.DualLayout == DualLayout.Watch && Settings.ContentScreen == ScreenSide.Left;
    var mirror = Settings.DualLayout == DualLayout.Mirror;
    <div class="layout-preview">
        <div class="small muted">Face</div>
        @if (twoLcds)
        {
            <div class="row" style="gap:.5rem;flex-wrap:nowrap"><LcdPreview BigEye="true" Size="size" /><LcdPreview BigEye="true" Size="size" /></div>
        }
        else
        {
            <LcdPreview Face="true" Size="size" />
        }
        <div class="small muted" style="margin-top:.5rem">App screens</div>
        @if (twoLcds)
        {
            <div class="row" style="gap:.5rem;flex-wrap:nowrap">
                @if (mirror || appOnLeft) { <LcdPreview Visual="VisualKind.Gauge" Name="Claude 5h" Value="63" Unit="%" Size="size" /> }
                else { <LcdPreview BigEye="true" EyeOffset="3" Size="size" /> }
                @if (mirror || !appOnLeft) { <LcdPreview Visual="VisualKind.Gauge" Name="Claude 5h" Value="63" Unit="%" Size="size" /> }
                else { <LcdPreview BigEye="true" EyeOffset="-3" Size="size" /> }
            </div>
        }
        else
        {
            <LcdPreview Visual="VisualKind.Gauge" Name="Claude 5h" Value="63" Unit="%" Size="size" />
        }
    </div>
    return;
}
<div class="layout-preview">
    <div class="small muted">Face</div>
    <div class="row" style="gap:.5rem;flex-wrap:nowrap">@foreach (var p in Panels(face: true)) { <div class="oled">@((MarkupString)p)</div> }</div>
    <div class="small muted" style="margin-top:.5rem">App screens</div>
    <div class="row" style="gap:.5rem;flex-wrap:nowrap">@foreach (var p in Panels(face: false)) { <div class="oled">@((MarkupString)p)</div> }</div>
</div>

@code {
    [Parameter, EditorRequired] public DeviceSettings Settings { get; set; } = new();
    /// <summary>With Automatic: the LCD DANTE reported it's using, if any.</summary>
    [Parameter] public LcdSize? DetectedLcd { get; set; }
    /// <summary>With an automatic screen count: how many screens DANTE reported it's using.</summary>
    [Parameter] public int? DetectedScreens { get; set; }

    private const int Scale = 2;

    private IEnumerable<string> Panels(bool face)
    {
        var two = Settings.ScreenCount == 2 || (Settings.ScreenCount == 0 && DetectedScreens == 2);
        if (!two)
        {
            yield return Svg(face ? Eye(40, 0) + Eye(88, 0) : Gauge());
            yield break;
        }
        var contentLeft = Settings.ContentScreen == ScreenSide.Left;
        for (var side = 0; side < 2; side++)
        {
            var isContent = Settings.DualLayout == DualLayout.Mirror || (side == 0) == contentLeft;
            if (face) yield return Svg(BigEye(0) + Label(side == 0 ? "L" : "R"));
            else if (isContent) yield return Svg(Gauge());
            else yield return Svg(BigEye(side == 0 ? 20 : -20) + Label("watching"));
        }
    }

    private static string N(double d) => d.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Svg(string body) =>
        $"""<svg viewBox="0 0 128 32" width="{128 * Scale}" height="{32 * Scale}" fill="var(--oled-px)" stroke="var(--oled-px)" font-family="monospace">{body}</svg>""";

    private static string Eye(double cx, double look) =>
        $"""<rect x="{N(cx - 12 + look)}" y="5" width="24" height="22" rx="5" stroke="none"/>""";

    private static string BigEye(double look) =>
        $"""<rect x="{N(64 - 28 + look)}" y="3" width="56" height="26" rx="8" stroke="none"/>""";

    private static string Label(string s) =>
        $"""<text x="2" y="30" font-size="6" stroke="none" opacity=".7">{s}</text>""";

    private static string Gauge() =>
        """<path d="M 3 30 A 17 17 0 0 1 32 18" fill="none" stroke-width="5"/><path d="M 3 30 A 17 17 0 0 1 37 30" fill="none" stroke-width="1"/>""" +
        """<text x="46" y="7" font-size="7" stroke="none">Claude 5h</text><text x="46" y="27" font-size="17" font-weight="700" stroke="none">63%</text>""";
}
