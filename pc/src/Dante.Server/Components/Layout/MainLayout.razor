@inherits LayoutComponentBase
@inject FeatureCatalog Features
@inject PluginRegistry Plugins

<div class="shell">
    <nav class="sidebar">
        <a class="brand" href="">
            <svg viewBox="0 0 64 32" width="56" height="28" aria-hidden="true">
                <rect x="1" y="1" width="62" height="30" rx="6" class="brand-screen" />
                <rect x="14" y="8" width="12" height="16" rx="4" class="brand-eye" />
                <rect x="38" y="8" width="12" height="16" rx="4" class="brand-eye" />
            </svg>
            <span class="brand-name">DANTE<small>Desk Assistant for Notifications, Tasks &amp; Efficiency</small></span>
        </a>
        @foreach (var item in Features.Navigation)
        {
            <NavLink href="@item.Href" Match="@(item.Href.Length == 0 || item.Href == Dante.Server.Features.Plugins.PluginsFeature.Href ? NavLinkMatch.All : NavLinkMatch.Prefix)">@item.Title</NavLink>
            @if (item.Href == Dante.Server.Features.Plugins.PluginsFeature.Href)
            {
                <div class="nav-group">
                    @foreach (var p in Plugins.All)
                    {
                        <NavLink href="@($"plugins/{p.Id}")">@p.Name</NavLink>
                    }
                </div>
            }
        }
    </nav>
    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>
